# Existing runtime and database settings
PORT=3000
NODE_ENV=development
DATABASE_URL=
CORS_ORIGINS=

# Telegram bot
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# OpenAI Chat Completions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_MS=25000
AI_MEMORY_LIMIT=20

# Barber Mini App / authentication
BARBER_TELEGRAM_IDS=
MINI_APP_URL=
ADMIN_KEY=
SHOP_ADDRESS=
# Client booking reminder lead time in minutes (default 120)
REMINDER_LEAD_MIN=120

# Optional compatibility with older Gemini OpenAI-compatible deployments
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# GEMINI_REASONING_EFFORT=low
# GEMINI_TIMEOUT_MS=25000
